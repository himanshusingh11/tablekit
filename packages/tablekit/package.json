{
  "name": "react-tablekit",
  "version": "0.1.0",
  "description": "A small, fast, accessible React data table: 100K-row virtualization, sorting, filtering, resizing, pinning, selection and full keyboard navigation.",
  "keywords": [
    "react",
    "table",
    "data-table",
    "datagrid",
    "grid",
    "virtualization",
    "virtual-scroll",
    "accessible",
    "a11y",
    "aria",
    "typescript"
  ],
  "license": "MIT",
  "author": "Himanshu Singh",
  "homepage": "https://himanshusingh11.github.io/tablekit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himanshusingh11/tablekit.git",
    "directory": "packages/tablekit"
  },
  "bugs": {
    "url": "https://github.com/himanshusingh11/tablekit/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "size-limit": [
    {
      "name": "react-tablekit (JS, ESM)",
      "path": "dist/index.js",
      "import": "{ useTable, DataTable }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "10 KB"
    },
    {
      "name": "react-tablekit/styles.css",
      "path": "dist/styles.css",
      "limit": "2 KB",
      "rolldown": false
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
